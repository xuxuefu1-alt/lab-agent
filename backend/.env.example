# SQLite is for local development only; production must use an externally reachable MySQL URL.
mysql_url=mysql+pymysql://lab_agent:lab_agent_demo@127.0.0.1:3306/lab_agent
APP_ENV=development
JWT_SECRT_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
